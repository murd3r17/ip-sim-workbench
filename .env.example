# ============================================================
# 环境变量模板（2026-08-17 Sprint B 治理后与真实键集对齐）
# 键分两类：
#   [共享] 根 .env 唯一来源：DB_*/MINIO_*/JWT_SECRET_KEY/FERNET_KEY/
#           LLM_*/KNOWLEDGE_*/DEVICE_DEFAULT_*（后端与 Compose/脚本共用）
#   [后端] backend/.env：DEBUG/APP_VERSION/MINIO_BUCKET/JWT_EXPIRE_MINUTES/
#           LLM_THINKING_ENABLED/LLM_REASONING_EFFORT/DEPLOY_SIMULATE_ONLY/
#           CORS_ORIGINS/LOG_LEVEL/LOG_DIR
# 复制两份：根目录 .env（共享）+ backend/.env（后端独有）。
# ============================================================

# ── [共享] 应用 ─────────────────────────────────────────────
# 注：APP_ENV 不是 Settings 字段（A-13），仅个别脚本读取；应用版本用 APP_VERSION。
APP_ENV=development
APP_VERSION=v7.0
DEBUG=false
# APP_NAME=IP仿真运维管理工作站
# API_PREFIX=/api/v1

# ── [共享] 数据库（工作台 MySQL，本地 13307）────────────────
DB_HOST=127.0.0.1
DB_PORT=13307
DB_USER=sim_admin
DB_PASSWORD=<set-in-local-.env>
DB_NAME=sim_workspace
# 连接池（有内置默认值，一般不用改）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# Compose/初始化用（根 .env 独有；Docker 已退役，保留仅为兼容旧部署脚本）
MYSQL_ROOT_PASSWORD=<set-in-local-.env>
MYSQL_PASSWORD=<set-in-local-.env>

# ── 最小运行模式（无 MySQL 也能跑；bootstrap -Mode minimal 会写入这些）──
# DB_BACKEND=sqlite 时用 .runtime/sim_workspace.db；空库自动迁移，已有旧库须备份后升级
# DB_BACKEND=sqlite
# DB_SQLITE_PATH=
# DB_URL=
# DB_AUTO_CREATE=

# ── [共享] MinIO（本地 9002/9003）──────────────────────────
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=<set-in-local-.env>
MINIO_SECRET_KEY=<set-in-local-.env>
# [后端] 桶名（backend/.env）
MINIO_BUCKET=sim-workstation

# ── [共享] 安全 ─────────────────────────────────────────────
JWT_SECRET_KEY=<generate-a-unique-secret>
FERNET_KEY=<generate-a-fernet-key>
# [后端] JWT 有效期（分钟，backend/.env）
JWT_EXPIRE_MINUTES=120
JWT_ALGORITHM=HS256

# ── [共享] 初始管理员（bootstrap_local*.py 用；禁止提交明文口令）──
# PowerShell bootstrap 在本机 .env 生成初始口令且不回显；直接 Python 初始化要求此项非空
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set-a-strong-password>

# ── [共享] 设备默认登录信息 ─────────────────────────────────
DEVICE_DEFAULT_USERNAME=<set-in-local-.env>
DEVICE_DEFAULT_PASSWORD=<set-in-local-.env>
DEVICE_DEFAULT_ENABLE=<set-in-local-.env>
# 设备执行模式：ssh（真机/eNSP）| sim（离线模拟，无设备也能跑通全链路）
# 新克隆默认 sim：无需真实设备即可演示 拓扑/监控/下发/实训 全链路
DEVICE_MODE=sim

# ── [共享] LLM（DeepSeek：OpenAI 兼容接口）─────────────────
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=<set-in-local-.env>
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.3
# [后端] DeepSeek 思考模式（backend/.env）
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high

# ── [共享] 知识库（AnythingLLM Desktop + 本地 Ollama 嵌入）──
KNOWLEDGE_PROVIDER=anythingllm
KNOWLEDGE_BASE_URL=http://127.0.0.1:3001
KNOWLEDGE_API_KEY=<set-in-local-.env>
KNOWLEDGE_WORKSPACE_SLUG=ip-ops-kb
KNOWLEDGE_DATASET_ID=
KNOWLEDGE_WORKSPACE_ID=
# 留空 = <仓库根>/knowledge/corpus/huawei-ip（local provider 检索这个目录）。
# 注意：不要写成 `KEY=   # 说明` —— 等号后面的内容（含注释）会整体成为取值。
KNOWLEDGE_CORPUS_DIR=
KNOWLEDGE_TOP_K=8
KNOWLEDGE_SIMILARITY_THRESHOLD=0.2
KNOWLEDGE_MAX_UPLOAD_MB=20
KNOWLEDGE_MAX_UPLOAD_FILES=200
KNOWLEDGE_REQUEST_TIMEOUT=180
# AnythingLLM 本地存储（空= %APPDATA%\anythingllm-desktop\storage）
KNOWLEDGE_ANYTHINGLLM_STORAGE=

# ── [后端] 配置下发 ─────────────────────────────────────────
# 默认只做模拟执行；关闭后真实下发仅允许白名单设备（backend/.env）
DEPLOY_SIMULATE_ONLY=true
# 受控执行/回滚白名单（当前 eNSP：R1/R2/R3 id 7/8/9，同管理地址不同端口）
DEPLOY_ALLOWLIST_DEVICE_IDS=
DEPLOY_ALLOWLIST_MGMT_IPS=
DEPLOY_ALLOWLIST_TOPOLOGY_ID=0
DEPLOY_ALLOWLIST_BASELINE_VERSION=0
# 设备写锁 TTL 与过期检查间隔（秒）。只有"未进入执行"的锁会被自动释放；正在 executing/
# verifying 的任务其锁不会被清（避免同一设备被并发写）。默认 1 小时 / 5 分钟检查一次。
# DEPLOY_LOCK_TTL_SECONDS=3600
# DEPLOY_LOCK_EXPIRE_CHECK_SECONDS=300
# 监控定时采集默认关闭（避免占用 NE40E VTY）；开启时建议间隔 >=120s
# MONITOR_SCHEDULER_ENABLED=false
# MONITOR_COLLECT_INTERVAL=120

# ── [后端] 日志/CORS（backend/.env）────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# 默认写到 <仓库根>/.runtime/logs（代码内置绝对路径）。如需自定义再取消注释；
# 注意相对路径是相对**进程 CWD**，启动脚本会把 CWD 设为 backend/（A-14）。
# LOG_DIR=../.runtime/logs
# LOG_RETENTION_DAYS=30

# ── [可选] 其余 Settings 字段（均有内置默认值，按需取消注释）────
# A-13：以下键此前完全没出现在模板里，使用者不知道可调。
# SSH 设备访问
# SSH_CONNECT_TIMEOUT=10
# SSH_COMMAND_TIMEOUT=30
# SSH_STRICT_HOST_KEY=false
# SSH_KNOWN_HOSTS=
# 配置下发节流
# DEPLOY_MAX_CONCURRENT=5
# DEPLOY_BATCH_SIZE=5
# DEPLOY_BATCH_INTERVAL=2.0
# TOPOLOGY_CONCURRENT_SSH=5
# 监控采集
# MONITOR_COLLECT_INTERVAL=60
# MONITOR_BATCH_SIZE=5
# MONITOR_BATCH_INTERVAL=2.0
# MONITOR_DEVICE_TIMEOUT=60
# MONITOR_RETENTION_DAYS=30
# ENSP_HEALTH_CHECK_INTERVAL=300
# WebSSH
# WebSSH：每用户并发终端会话上限（设计 §16 建议 5-10；超限会明确提示"并发终端会话数已达上限"）
# WEBSSH_MAX_SESSIONS_PER_USER=5
# WEBSSH_LOG_RETENTION_DAYS=30
# 视觉模型与附件类型白名单
# LLM_VISION_MODEL=
# LLM_VISION_MIME_WHITELIST=image/png,image/jpeg,image/webp,image/gif
# MinIO
# MINIO_SECURE=false
# 已退役的 RAGFlow（provider 不再是 ragflow 时无需配置）
# RAG_BASE_URL=http://localhost:80
# RAG_USERNAME=admin
# RAG_PASSWORD=
# RAG_JWT_TOKEN=
# RAG_DEFAULT_KB_ID=1

# 工作台不读 EMBEDDING_*：嵌入由 AnythingLLM 调用本地 Ollama nomic-embed-text。
# WEBSSH_PORT / ENSP_API_* 未接入（WebSSH 走 FastAPI WS；设备经 SSH 直连）。

# ── 预留（当前实现为 SSH 管理设备，eNSP API 未使用）────────
# ENSP_API_BASE=
# ENSP_API_USER=
# ENSP_API_PASSWORD=
